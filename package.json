{
  "name": "isaac-multi-run-timer",
  "version": "0.0.0",
  "description": "A mod for The Binding of Isaac: Repentance.",
  "keywords": [
    "isaac",
    "mod",
    "rebirth",
    "afterbirth",
    "repentance"
  ],
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "build": "bunx --bun tstl",
    "lint": "bun run ./scripts/lint.ts",
    "nuke": "bunx --bun isaacscript nuke",
    "publish": "bunx --bun isaacscript publish",
    "start": "bunx --bun isaacscript monitor",
    "update": "bunx --bun isaacscript update"
  },
  "dependencies": {
    "isaac-typescript-definitions": "43.0.8",
    "isaacscript-common": "87.10.1"
  },
  "devDependencies": {
    "complete-node": "18.0.0",
    "isaacscript": "6.0.11",
    "isaacscript-lint": "8.1.0",
    "typescript": "6.0.2",
    "typescript-to-lua": "1.37.1"
  }
}
